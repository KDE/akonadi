include($KDE_DOCS/global/qt-module-defaults.qdocconf)

project = AkonadiWidgets
moduleheader = akonadiwidgets_qdocmoduleheader.h
description = PIM Storage Framework.


documentationinheaders = true

headers += \
    agentconfigurationdialog.h \
    agentconfigurationwidget.h \
    agentinstancewidget.h \
    agenttypedialog.h \
    agenttypewidget.h \
    akonadiwidgets_qdocmoduleheader.h \
    clearcachefoldersjob.h \
    collectioncombobox.h \
    collectiondialog.h \
    collectionmaintenancepage.h \
    collectionpropertiesdialog.h \
    collectionpropertiespage.h \
    collectionrequester.h \
    collectionstatisticsdelegate.h \
    controlgui.h \
    dbaccess.h \
    entitylistview.h \
    entitytreeview.h \
    etmviewstatesaver.h \
    manageaccountwidget.h \
    standardactionmanager.h \
    subscriptiondialog.h \
    tageditwidget.h \
    tagmanagementdialog.h \
    tagselectioncombobox.h \
    tagselectiondialog.h \
    tagselectwidget.h \
    tagwidget.h
sourcedirs += .

outputformats = HTML

depends += \
    qtcore

navigation.landingpage = "AkonadiWidgets"

qhp.projects            = akonadiwidgets

qhp.akonadiwidgets.file                = akonadiwidgets.qhp
qhp.akonadiwidgets.namespace           = org.kde.akonadiwidgets.$QT_VERSION_TAG
qhp.akonadiwidgets.virtualFolder       = akonadiwidgets
qhp.akonadiwidgets.indexTitle          = AkonadiWidgets
qhp.akonadiwidgets.indexRoot           =

qhp.akonadiwidgets.subprojects         = classes
qhp.akonadiwidgets.subprojects.classes.title = C++ Classes
qhp.akonadiwidgets.subprojects.classes.indexTitle = Akonadi Widgets C++ Classes
qhp.akonadiwidgets.subprojects.classes.selectors = class fake:headerfile
qhp.akonadiwidgets.subprojects.classes.sortPages = true

tagfile = akonadiwidgets.tags
